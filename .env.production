# Production build config. VITE_ values are baked into the bundle at build
# time and none are secrets. Vercel: set these same values in the project's
# Environment Variables, they win over this file.
VITE_API_URL=https://invoicier-be.fly.dev/api/v1
VITE_USE_MOCKS=false
VITE_ENVIRONMENT=production
VITE_WAITLIST_MODE=true
