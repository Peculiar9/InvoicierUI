# API Configuration. Relative by default so the deployed build calls its own
# origin (/api), which the mock backend intercepts. Set to an absolute backend
# URL only when VITE_USE_MOCKS=false.
VITE_API_URL=/api

# Use the in-app mock backend (localStorage-backed), in dev AND production.
# Set to "false" to hit a real VITE_API_URL instead.
VITE_USE_MOCKS=true

# EmailJS (optional) — when all three are set, "Send" emails invoices for real
# via the EmailJS REST API. Without them, Send opens the user's mail composer (mailto:).
# Get these from https://emailjs.com -> Email Services / Templates / Account (Public Key).
# Your EmailJS template should use the params: to_email, to_name, from_name, subject, message
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Strapi CMS (marketing copy, FAQs, testimonials, waitlist)
VITE_CMS_URL=http://localhost:1337

# Launch switch: true sells the waitlist and hides every login link
VITE_WAITLIST_MODE=false

# development shows the floating test shortcuts; production hides them
VITE_ENVIRONMENT=development

# Product analytics (PostHog). Leave the key blank to disable analytics entirely.
# Key: PostHog project settings ("project token", starts phc_); host is
# us.i.posthog.com or eu.i.posthog.com. The CONFIG_ prefix reads as plain config
# to Vercel (it does not gate it as a public prefix); the old VITE_PUBLIC_ names
# still work as a fallback. The value is public either way — that is correct for
# a PostHog project token.
CONFIG_POSTHOG_KEY=
CONFIG_POSTHOG_HOST=https://us.i.posthog.com
